# Copy this file to `.env` and fill in the values. Never commit `.env`.

# REQUIRED: your Metaculus bot token.
# Create the bot in your Metaculus settings ("My Forecasting Bots"), then
# copy its access token from the bot's page. See README.md.
METACULUS_API_KEY=

# LLM (optional but strongly recommended -- without one, the bot uses the
# deterministic base-rate fallback forecaster).
# Easiest: OpenRouter. Seasonal-tournament participants can get free credits
# via the participation form (see README.md), then create a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Alternatives (any one is enough):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Or a fully explicit OpenAI-compatible endpoint:
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=

# News research (optional): AskNews is free for registered bot builders.
# ASKNEWS_CLIENT_ID=
# ASKNEWS_SECRET=

# Polling: tournament questions are open for only ~3 hours, so keep this
# small during the season. Default 5.
POLL_INTERVAL_MINUTES=5

# Optional override of the tournaments to forecast on (comma-separated
# slugs/ids). Default: the forecasting-tools constants for the current
# seasonal FutureEval tournament and MiniBench.
# TOURNAMENTS=fall-futureeval-2026,minibench
